{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:recommended",
    "group:monorepos",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Seoul",
  "enabledManagers": ["pnpm", "github-actions"],
  "labels": ["dependencies"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep workspace package ranges moving without pinning published package dependencies.",
      "matchManagers": ["pnpm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep dependency updates within the framework lane.",
      "matchPackageNames": [
        "@mdx-js/**",
        "@next/**",
        "@tanstack/react-query",
        "next",
        "react",
        "react-dom"
      ],
      "groupName": "framework dependencies",
      "groupSlug": "framework-dependencies"
    },
    {
      "description": "Keep dependency updates within the UI lane.",
      "matchPackageNames": [
        "@base-ui/**",
        "@excalidraw/**",
        "@tailwindcss/**",
        "@tanstack/react-virtual",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "lucide-react",
        "motion",
        "shadcn",
        "tailwind-merge",
        "tailwindcss",
        "tw-animate-css"
      ],
      "groupName": "UI dependencies",
      "groupSlug": "ui-dependencies"
    },
    {
      "description": "Keep dependency updates within the desktop lane.",
      "matchPackageNames": [
        "@codemirror/**",
        "@electron/**",
        "@electron-forge/**",
        "@trpc/**",
        "@xterm/**",
        "ds-store",
        "electron",
        "fflate",
        "macos-alias",
        "node-gyp",
        "node-pty",
        "uuid",
        "zod",
        "zustand"
      ],
      "groupName": "desktop dependencies",
      "groupSlug": "desktop-dependencies"
    },
    {
      "description": "Keep dependency updates within the test lane.",
      "matchPackageNames": [
        "@axe-core/**",
        "@playwright/**",
        "@vitest/**",
        "vitest"
      ],
      "groupName": "test dependencies",
      "groupSlug": "test-dependencies"
    },
    {
      "description": "Keep dependency updates within the tooling lane.",
      "matchPackageNames": [
        "@types/**",
        "@vitejs/**",
        "esbuild",
        "gray-matter",
        "hast-util-to-string",
        "npm-check-updates",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "postcss",
        "rehype-slug",
        "remark-*",
        "typescript",
        "unist-util-visit",
        "vite"
      ],
      "groupName": "tooling dependencies",
      "groupSlug": "tooling-dependencies"
    },
    {
      "description": "Require dashboard approval before opening major pnpm dependency updates.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
