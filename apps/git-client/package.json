{
  "name": "@jongminchung/git-client",
  "version": "0.1.0",
  "private": true,
  "description": "An independently audited, Rebased-inspired Electron Git client for macOS",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "benchmark": "node scripts/benchmark.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && vite build",
    "dev": "electron-forge start",
    "electron:make": "electron-forge make",
    "electron:package": "electron-forge package",
    "electron:smoke-package": "node scripts/smoke-electron-package.mjs",
    "electron:start": "electron-forge start",
    "electron:verify-package": "node scripts/verify-electron-package.mjs",
    "parity:affected": "node scripts/parity/run-parity.mjs affected",
    "parity:check": "node scripts/parity/check-completion.mjs",
    "parity:compact": "node scripts/qa/compact-parity-report.mjs",
    "parity:explain": "node scripts/parity/run-parity.mjs explain",
    "parity:full": "node scripts/parity/run-parity.mjs full",
    "parity:mvp": "node scripts/parity/run-parity.mjs mvp",
    "parity:next": "node scripts/parity/run-parity.mjs next",
    "parity:test": "node scripts/parity/run-parity.mjs test",
    "parity:theme": "vitest run --root ../.. apps/git-client/scripts/parity/theme-contract.test.ts --reporter=agent --silent=passed-only && playwright test tests/theme-parity.spec.ts",
    "qa:compact": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "qa:compact:electron": "pnpm test:electron",
    "qa:verbose": "GIT_CLIENT_VERBOSE_TESTS=1 pnpm test:e2e",
    "release": "node scripts/publish-release.mjs",
    "release:build": "node scripts/release.mjs",
    "release:dry-run": "node scripts/publish-release.mjs --dry-run",
    "release:validate-local": "node scripts/release.mjs --local-ad-hoc",
    "test": "vitest run --root ../.. apps/git-client --reporter=agent --silent=passed-only",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:electron-package-policy": "node --test scripts/electron-package-policy.node-test.mjs",
    "test:scripts": "node --test scripts/*.node-test.mjs scripts/independent-audit/*.node-test.mjs scripts/parity/*.node-test.mjs",
    "test:verbose": "vitest run --root ../.. apps/git-client --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-java": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/merge": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@jongminchung/theme-contract": "workspace:*",
    "@jongminchung/ui": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "@vscode/ripgrep": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "chokidar": "catalog:",
    "fflate": "catalog:",
    "lucide-react": "catalog:",
    "node-pty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@electron-forge/cli": "catalog:",
    "@electron-forge/maker-dmg": "catalog:",
    "@electron-forge/plugin-auto-unpack-natives": "catalog:",
    "@electron-forge/plugin-fuses": "catalog:",
    "@electron-forge/plugin-vite": "catalog:",
    "@electron-forge/shared-types": "catalog:",
    "@electron/fuses": "catalog:",
    "@electron/rebuild": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "ds-store": "catalog:",
    "electron": "catalog:",
    "fs-xattr": "catalog:",
    "macos-alias": "catalog:",
    "node-gyp": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
