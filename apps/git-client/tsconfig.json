{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["source"],
    "paths": {},
    "rootDir": ".",
    "types": ["vite/client", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
