{
  "name": "@jongminchung/engineering-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-excalidraw-assets.ts && node scripts/check-excalidraw.ts && pnpm run content:check && next build",
    "content:build": "node scripts/build-content.ts --write",
    "content:check": "node scripts/build-content.ts --check",
    "dev": "node scripts/prepare-excalidraw-assets.ts && next dev",
    "excalidraw:assets": "node scripts/prepare-excalidraw-assets.ts",
    "excalidraw:check": "node scripts/check-excalidraw.ts",
    "start": "next start",
    "test": "vitest run --root ../.. apps/engineering-docs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "@jongminchung/icon": "workspace:*",
    "@jongminchung/theme-contract": "workspace:*",
    "@jongminchung/ui": "workspace:*",
    "@mdx-js/loader": "catalog:",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "gray-matter": "catalog:",
    "hast-util-to-string": "catalog:",
    "postcss": "catalog:",
    "rehype-slug": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-mdx-frontmatter": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:",
    "vitest": "catalog:"
  }
}
