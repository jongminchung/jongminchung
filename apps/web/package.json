{
  "name": "@jongminchung/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#lib/*": "./lib/*.ts"
  },
  "scripts": {
    "build": "node scripts/check-excalidraw.ts && next build",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-excalidraw-assets.ts",
    "predev": "node scripts/prepare-excalidraw-assets.ts",
    "start": "node scripts/prepare-standalone.ts && node --no-require-module .next/standalone/apps/web/server.js",
    "test": "vitest run --root ../.. apps/web",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "@jongminchung/ui": "workspace:*",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "pretendard": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "gray-matter": "catalog:",
    "hast-util-to-string": "catalog:",
    "postcss": "catalog:",
    "rehype-slug": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-kroki": "catalog:",
    "remark-mdx-frontmatter": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:",
    "vitest": "catalog:"
  }
}
