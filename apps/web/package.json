{
  "name": "@jongminchung/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#home-components/*": "./app/(home)/_components/*.tsx",
    "#invest-components/*": "./app/(invest)/_components/*.tsx",
    "#lib/*": "./lib/*.ts",
    "#mdx-components": "./mdx-components.tsx",
    "#tech-components/*": "./app/(tech)/_components/*.tsx"
  },
  "scripts": {
    "build": "bun run --bun fumadocs-mdx && JAMIE_MDX_METADATA_ONLY=1 bun --preload ./scripts/register-content-plugin.ts scripts/validate-fumadocs-content.ts && bun scripts/check-excalidraw.ts && bun run --bun next build",
    "content:evidence": "bun --preload ./scripts/register-content-plugin.ts scripts/content-evidence.ts",
    "dev": "bun run --bun next dev",
    "dev:home": "JAMIE_LOCAL_SITE=home bun run dev",
    "dev:invest": "JAMIE_LOCAL_SITE=invest bun run dev",
    "dev:tech": "JAMIE_LOCAL_SITE=tech bun run dev",
    "prebuild": "bun scripts/prepare-excalidraw-assets.ts",
    "predev": "bun scripts/prepare-excalidraw-assets.ts",
    "postinstall": "bun run --bun fumadocs-mdx",
    "start": "bun scripts/prepare-standalone.ts && bun .next/standalone/apps/web/server.js",
    "test": "bun test --timeout 60000",
    "test:e2e": "playwright test",
    "typecheck": "bun run --bun next typegen && bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "@jongminchung/ui": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@fumadocs/tailwind": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/mdast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:"
  }
}
