{
  "name": "@jongminchung/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#home-components/*": "./app/(home)/_components/*.tsx",
    "#invest-components/*": "./app/(invest)/_components/*.tsx",
    "#lib/*": "./lib/*.ts",
    "#mdx-components": "./mdx-components.tsx",
    "#tech-components/*": "./app/(tech)/_components/*.tsx"
  },
  "scripts": {
    "build": "fumadocs-mdx && node --import ./scripts/register-content-loader.ts scripts/validate-fumadocs-content.ts && node scripts/check-excalidraw.ts && next build",
    "content:evidence": "node --import ./scripts/register-content-loader.ts scripts/content-evidence.ts",
    "dev": "next dev",
    "dev:home": "JAMIE_LOCAL_SITE=home pnpm run dev",
    "dev:invest": "JAMIE_LOCAL_SITE=invest pnpm run dev",
    "dev:tech": "JAMIE_LOCAL_SITE=tech pnpm run dev",
    "prebuild": "node scripts/prepare-excalidraw-assets.ts",
    "predev": "node scripts/prepare-excalidraw-assets.ts",
    "postinstall": "fumadocs-mdx",
    "start": "node scripts/prepare-standalone.ts && node --no-require-module .next/standalone/apps/web/server.js",
    "test": "vitest run --root ../.. apps/web",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "@jongminchung/ui": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:",
    "vitest": "catalog:"
  }
}
