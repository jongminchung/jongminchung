{
  "name": "@jongminchung/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#home-components/*": "./app/(home)/_components/*.tsx",
    "#invest-components/*": "./app/(invest)/_components/*.tsx",
    "#lib/*": "./lib/*.ts",
    "#tech-components/*": "./app/(tech)/_components/*.tsx"
  },
  "scripts": {
    "bundle:report": "node ../../scripts/report-frontend-assets.mjs --app=web --root=apps/web/.next/static --baseline=apps/web/bundle-baseline.json",
    "bundle:baseline": "pnpm run bundle:report -- --update-baseline",
    "build": "node scripts/check-excalidraw.ts && next build",
    "content:evidence": "node scripts/content-evidence.ts",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-excalidraw-assets.ts",
    "predev": "node scripts/prepare-excalidraw-assets.ts",
    "start": "node scripts/prepare-standalone.ts && node --no-require-module .next/standalone/apps/web/server.js",
    "test": "vitest run --root ../.. apps/web",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "catalog:",
    "@jongminchung/ui": "workspace:*",
    "@mdx-js/mdx": "catalog:",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "gray-matter": "catalog:",
    "hast-util-to-string": "catalog:",
    "postcss": "catalog:",
    "rehype-slug": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-kroki": "catalog:",
    "remark-mdx-frontmatter": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "catalog:",
    "vitest": "catalog:"
  }
}
