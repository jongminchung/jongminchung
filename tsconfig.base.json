{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "libReplacement": false,
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@jongminchung/tooling/oxfmt": ["./packages/tooling/src/oxfmt/index.ts"],
      "@jongminchung/tooling/oxlint.json": ["./packages/tooling/oxlint.json"],
      "@jongminchung/ui/components/*": ["./packages/ui/src/components/*.tsx"],
      "@jongminchung/ui/globals.css": ["./packages/ui/src/styles/globals.css"],
      "@jongminchung/ui/lib/*": ["./packages/ui/src/lib/*.ts"],
      "@jongminchung/ui/theme.css": ["./packages/ui/src/styles/theme.css"],
      "@jongminchung/ui/tokens.css": ["./packages/ui/src/styles/tokens.css"]
    },
    "resolvePackageJsonImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
