{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 공통 옵션의 의미: https://www.typescriptlang.org/tsconfig/
  "compilerOptions": {
    // Bun이 직접 실행하는 스크립트의 .ts import를 허용함. JS 배포 빌드에서는 끔.
    "allowImportingTsExtensions": true,
    // 검사 진입점은 TS/TSX로 제한함. JS 설정 파일은 이 옵션으로 검사되지 않음.
    "allowJs": false,
    // CommonJS 라이브러리와 ESM import 사이의 타입 호환을 지원함.
    "esModuleInterop": true,
    // 파일명 대소문자 차이로 로컬과 Linux CI의 import 결과가 달라지는 것을 방지함.
    "forceConsistentCasingInFileNames": true,
    // 공유 UI 배포 시 자동 JSX runtime을 사용함. Next 앱은 preserve로 재정의함.
    "jsx": "react-jsx",
    // 공통 설정은 ECMAScript만 제공함. DOM 타입은 웹·UI workspace에서 추가함.
    "lib": ["ESNext"],
    // 외부 @typescript/lib-* 대신 설치된 TypeScript의 표준 lib 선언을 사용함.
    "libReplacement": false,
    // import 구문을 유지하고 실제 변환은 Bun·Next에 맡김.
    "module": "Preserve",
    // import가 없는 파일도 모듈로 취급해 파일 간 전역 이름 충돌을 막음.
    "moduleDetection": "force",
    // 번들러의 모듈 해석을 따름. Node에 배포하는 패키지는 NodeNext로 재정의함.
    "moduleResolution": "bundler",
    // 기본 검사는 파일을 생성하지 않음. 패키지 배포용 설정만 emit을 활성화함.
    "noEmit": true,
    // break 누락으로 다음 case가 실행되는 실수를 검사함.
    "noFallthroughCasesInSwitch": true,
    // 상위 클래스 멤버 재정의를 명시해 부모 API 변경을 감지함.
    "noImplicitOverride": true,
    // 인덱스 시그니처 속성의 점 표기를 허용함.
    // 개선 후보: true 전환 시 동적 키 접근을 대괄호로 명시해야 하므로 사용처부터 점검함.
    "noPropertyAccessFromIndexSignature": false,
    // 부수효과 import의 잘못된 경로를 감지함. CSS 등은 별도 타입 선언이 필요함.
    "noUncheckedSideEffectImports": true,
    // 배열·사전 조회에 undefined 가능성을 반영해 누락된 값 처리를 요구함.
    "noUncheckedIndexedAccess": true,
    // 사용하지 않는 지역 선언을 찾아 제거하거나 잘못된 참조를 수정하게 함.
    "noUnusedLocals": true,
    // 사용하지 않는 매개변수를 검사함. 의도적으로 미사용이면 _ 접두사를 사용함.
    "noUnusedParameters": true,
    // 저장소 안에서는 공유 패키지 소스를 직접 타입 검사함.
    // paths는 런타임 import를 바꾸지 않으므로 package exports·Next 설정과 함께 유지함.
    "paths": {
      // Workspace에서는 UI 공개 subpath를 source로 해석해 consumer와 같은 graph를 검사함
      "@jongminchung/ui/components/*": ["./packages/ui/src/components/*.tsx"],
      "@jongminchung/ui/globals.css": ["./packages/ui/src/styles/globals.css"],
      "@jongminchung/ui/hooks/*": ["./packages/ui/src/hooks/*.ts"],
      "@jongminchung/ui/root.css": ["./packages/ui/src/styles/root.css"],
      "@jongminchung/ui/lib/*": ["./packages/ui/src/lib/*.ts"],
      "@jongminchung/ui/theme.css": ["./packages/ui/src/styles/theme.css"],
      "@jongminchung/ui/tokens.css": ["./packages/ui/src/styles/tokens.css"]
    },
    // 각 workspace package.json의 #components/* 같은 imports 매핑을 해석함.
    "resolvePackageJsonImports": true,
    // JSON import의 구조를 추론해 설정 데이터 접근을 검사함.
    "resolveJsonModule": true,
    // 의존성 .d.ts 내부 검사를 생략해 검사 비용을 줄임. 앱 코드 검사는 유지함.
    // 개선 후보: TS·React 타입 업그레이드 시 false로 별도 검사해 선언 충돌을 확인함.
    "skipLibCheck": true,
    // null·암시적 any 등 기본 타입 오류를 엄격히 검사함.
    "strict": true,
    // 속성 생략과 명시적 undefined 전달을 구분해 optional props 계약을 검사함.
    "exactOptionalPropertyTypes": true,
    // 개발 검사에서는 최신 문법을 허용함. 배포 패키지는 지원 Node에 맞춰 ES2024로 고정함.
    "target": "ESNext",
    // 기본 전역 타입은 Node로 제한함. Bun·React 타입은 필요한 workspace에서 추가함.
    "types": ["node"],
    // 타입 전용 참조에 import type을 요구해 실행 시 불필요한 import가 남지 않게 함.
    "verbatimModuleSyntax": true
  }
}
