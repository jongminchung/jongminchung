root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,mdx}]
indent_size = 4
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[{*.go,Makefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 2
