{
  "name": "@jongminchung/tooling",
  "version": "1.0.0",
  "description": "Shared format, lint, and package-map configuration for TypeScript workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongminchung/jongminchung.git",
    "directory": "packages/tooling"
  },
  "files": [
    "dist",
    "src/oxfmt/index.ts",
    "src/**/*.json",
    "src/oxlint/index.ts",
    "src/package-map.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "source": "./src/oxlint/index.ts",
      "import": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "source": "./src/oxfmt/index.ts",
      "import": "./dist/oxfmt/index.js"
    },
    "./package-map": {
      "types": "./dist/package-map.d.ts",
      "source": "./src/package-map.ts",
      "import": "./dist/package-map.js"
    },
    "./oxlint.json": "./src/oxlint/base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "package-map": "node --experimental-strip-types src/package-map-cli.ts",
    "package-map:write": "node --experimental-strip-types src/package-map-cli.ts --write",
    "prepack": "pnpm run build",
    "publish:dry-run": "pnpm publish --dry-run --access public --no-git-checks",
    "test": "vitest run --root ../.. packages/tooling",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "tags": [
      "pkg:tooling"
    ]
  }
}
