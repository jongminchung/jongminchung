{
  "name": "@jongminchung/tooling",
  "version": "1.0.0",
  "description": "Shared format and lint configuration for TypeScript workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongminchung/jongminchung.git",
    "directory": "packages/tooling"
  },
  "files": [
    "dist",
    "src/oxfmt/index.ts",
    "oxlint.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "source": "./src/oxfmt/index.ts",
      "import": "./dist/oxfmt/index.js"
    },
    "./oxlint.json": "./oxlint.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "publish:dry-run": "pnpm publish --dry-run --access public --no-git-checks",
    "test": "vitest run --root ../.. packages/tooling",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": "catalog:tooling-peer",
    "oxlint": "catalog:tooling-peer",
    "oxlint-tsgolint": "catalog:tooling-peer"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
