{
  "name": "@jongminchung/tooling",
  "version": "1.0.0",
  "description": "Shared format and lint configuration for TypeScript workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongminchung/jongminchung.git",
    "directory": "packages/tooling"
  },
  "files": [
    "dist",
    "src/oxfmt/index.ts",
    "src/oxlint/index.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "source": "./src/oxfmt/index.ts",
      "import": "./dist/oxfmt/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "source": "./src/oxlint/index.ts",
      "import": "./dist/oxlint/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "publish:dry-run": "bun publish --dry-run --access public",
    "test": "bun test",
    "test:node": "bun run build && node ../../.github/scripts/verify-package-build.ts .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": "catalog:tooling-peer",
    "oxlint": "catalog:tooling-peer",
    "oxlint-tsgolint": "catalog:tooling-peer"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
