{
  // 개발 검사 정책을 재사용하되 Node에서 소비할 JS·타입 선언을 생성함.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 출력 JS에 실행 불가능한 .ts import가 남지 않도록 제한함.
    "allowImportingTsExtensions": false,
    // 소비 프로젝트가 공개 API를 타입 검사할 수 있도록 .d.ts를 배포함.
    "declaration": true,
    // 타입 선언에서 원본으로 이동하는 map은 현재 배포 산출물에서 생략함.
    "declarationMap": false,
    // 지원 런타임의 표준 API 타입으로 제한함. 브라우저 DOM 전역은 제공하지 않음.
    "lib": ["ES2024"],
    // Node ESM의 확장자·package exports 규칙에 맞는 모듈을 생성함.
    "module": "NodeNext",
    // 타입 검사도 Node ESM 해석 규칙을 따라 배포 후 import 오류를 줄임.
    "moduleResolution": "NodeNext",
    // 공통 noEmit을 해제해 JS와 타입 선언을 실제로 생성함.
    "noEmit": false,
    // 타입 오류가 있는 결과물이 배포 디렉터리에 생성되는 것을 막음.
    "noEmitOnError": true,
    // package.json의 exports가 가리키는 배포 디렉터리임.
    "outDir": "dist",
    // src 아래 구조를 dist에서도 유지해 공개 subpath와 출력 경로를 맞춤.
    "rootDir": "src",
    // 런타임 디버깅용 JS map은 현재 배포 산출물에서 생략함.
    "sourceMap": false,
    // 배포 JS 문법을 ES2024로 고정함. 런타임 API polyfill은 생성하지 않음.
    "target": "ES2024"
  },
  "files": ["src/oxfmt/index.ts", "src/oxlint/index.ts"]
}
