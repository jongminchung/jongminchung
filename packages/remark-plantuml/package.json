{
  "name": "@jongminchung/remark-plantuml",
  "version": "1.0.0",
  "description": "Remark plugin for rendering PlantUML diagrams in Markdown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongminchung/jongminchung.git",
    "directory": "packages/remark-plantuml"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/astro.ts",
    "src/styles.css",
    "src/starlight.css",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/starlight.css",
    "./src/styles.css",
    "./src/starlight.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "source": "./src/astro.ts",
      "default": "./dist/astro.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./starlight.css": {
      "source": "./src/starlight.css",
      "default": "./dist/starlight.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown --log-level error --no-report",
    "prepack": "pnpm run build",
    "publish:dry-run": "pnpm publish --dry-run --access public",
    "test": "vitest run --root ../.. packages/remark-plantuml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "nx": {
    "tags": [
      "pkg:remark-plantuml"
    ]
  }
}
