@startuml
!include <C4/C4_Component>

title Web 애플리케이션 내부 · C4 Level 3

LAYOUT_LEFT_RIGHT()

Person(visitor, "방문자")
Container_Ext(browser, "브라우저", "HTML, RSC payload, client JavaScript")
Container_Ext(content, "MDX·Excalidraw 원본", "apps/web/content, apps/web/public")
Container_Ext(sharedUi, "@jongminchung/ui", "React primitive와 Tailwind CSS 계약")

Container_Boundary(web, "@jongminchung/web") {
  Component(proxy, "Host proxy", "proxy.ts, site-routing.ts", "Host를 home·tech·invest로 해석하고 locale redirect 또는 내부 route rewrite를 수행함")
  Component(routes, "App Router route groups", "app/(home), app/(tech), app/(invest), app/(system)", "layout·page·route handler와 metadata를 제공함")
  Component(repository, "Content repository", "lib/content-repository.ts", "Fumadocs collection을 검증된 불변 snapshot으로 변환함")
  Component(domain, "도메인 규칙", "lib/home, lib/tech, lib/invest", "locale·검색·문서 탐색·투자 노트 규칙을 계산함")
  Component(mdx, "MDX pipeline", "source.config.ts, fumadocs-source.ts", "frontmatter를 Zod로 검증하고 MDX를 React 컴포넌트로 컴파일함")
  Component(ui, "제품 UI와 MDX components", "components, app/*/_components", "공유 primitive를 조합하고 client 경계를 최소 범위로 둠")
}

Rel(visitor, browser, "탐색·상호작용")
Rel(browser, proxy, "Host가 포함된 요청", "HTTP")
Rel(proxy, routes, "내부 /home·/tech·/invest 경로로 rewrite")
Rel(routes, domain, "page model·metadata·검색 결과 요청")
Rel(domain, repository, "게시된 snapshot 조회")
Rel(repository, mdx, "collection page와 본문 로드")
Rel(mdx, content, "원본 읽기와 자산 참조")
Rel(routes, ui, "Server·Client Component 합성")
Rel(ui, sharedUi, "공유 primitive와 CSS import")
Rel(routes, browser, "HTML·RSC·선택적 client bundle 응답")

SHOW_LEGEND()
@enduml
