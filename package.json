{
  "name": "jongminchung",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run deadcode && pnpm run test",
    "check:full": "pnpm run check && pnpm run test:e2e",
    "deadcode": "knip --include files --include duplicates --no-config-hints",
    "fmt": "oxfmt --config oxfmt.config.ts .",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "links:check": "scripts/check-links.sh",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:coverage:update": "vitest run --project unit --coverage --coverage.thresholds.autoUpdate",
    "test:e2e": "pnpm run build && pnpm --filter @jongminchung/web run test:e2e",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@jongminchung/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "fumadocs-mdx": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.13.0"
  },
  "packageManager": "pnpm@11.15.1",
  "//": [
    "audit:prod checks production dependency advisories at high severity or above.",
    "It stays separate from check because the advisory database requires network access; run it manually before publishing."
  ]
}
