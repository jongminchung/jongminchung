{
  "name": "jongminchung",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@axe-core/playwright": "4.12.1",
      "@base-ui/react": "1.6.0",
      "@excalidraw/excalidraw": "0.18.1",
      "@fumadocs/tailwind": "0.1.1",
      "@playwright/test": "1.62.1",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.0",
      "@types/mdast": "4.0.4",
      "@types/mdx": "2.0.14",
      "@types/node": "26.2.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "babel-plugin-react-compiler": "1.0.0",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cmdk": "1.1.1",
      "esbuild": "0.28.2",
      "fumadocs-core": "16.15.1",
      "fumadocs-mdx": "15.3.1",
      "fumadocs-ui": "16.15.1",
      "happy-dom": "^20.11.6",
      "knip": "6.33.0",
      "lucide-react": "1.30.0",
      "mdast-util-mdx-jsx": "3.2.0",
      "next": "16.3.1",
      "next-intl": "4.14.0",
      "next-themes": "0.4.6",
      "oxfmt": "0.66.0",
      "oxlint": "1.81.0",
      "oxlint-tsgolint": "7.0.2001",
      "postcss": "8.5.26",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "server-only": "0.0.1",
      "shadcn": "4.17.0",
      "tailwindcss": "4.3.3",
      "tailwind-merge": "3.6.0",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "unist-util-visit": "5.1.0",
      "zod": "4.4.3"
    },
    "catalogs": {
      "ui-peer": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --audit-level high",
    "build": "bun run --workspaces --if-present build",
    "check": "make lint && bun run typecheck && bun run deadcode && bun run test",
    "check:full": "bun run check && bun run test:e2e",
    "deadcode": "knip --include files,duplicates,dependencies,unlisted,catalog,catalogReferences --no-config-hints",
    "fmt": "oxfmt --config oxfmt.config.ts . && bun scripts/style-shell.ts write",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check . && bun scripts/style-shell.ts check",
    "lint": "oxlint --config oxlint.config.ts .",
    "links:check": "bun scripts/check-links.ts",
    "postinstall": "bun run --filter @jongminchung/web postinstall",
    "test": "bun run --workspaces --if-present test:coverage && bun run test:node",
    "test:e2e": "bun run --workspaces --if-present test:e2e",
    "test:node": "bun run --workspaces --if-present test:node",
    "typecheck": "tsc --noEmit && bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@jongminchung/generate-article-image-skill": "file:.agents/skills/generate-article-image",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "fast-uri": "3.1.6",
    "lodash-es": "4.18.1",
    "nanoid": "5.1.16",
    "sharp": "0.35.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "sharp"
  ],
  "//": [
    "audit checks dependency advisories at high severity or above.",
    "It stays separate from check because the advisory database requires network access; run it manually before publishing.",
    "workspaces.catalog는 TS·React·Next와 도구 버전을 한 곳에서 관리해 workspace 간 버전 차이를 줄임.",
    "typescript는 정적 타입 검사, @types/node는 루트 자동화 스크립트의 Node API 선언에 필요함.",
    "oxlint·oxlint-tsgolint는 코드 및 타입 기반 린트, oxfmt는 포맷, knip은 미사용 파일·의존성 검사를 담당함.",
    "개선 후보: TS·React·Next 업그레이드는 catalog와 lockfile을 함께 갱신하고 typecheck·test·build로 호환성을 확인함."
  ]
}
