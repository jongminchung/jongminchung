{
  "name": "jongminchung",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@axe-core/playwright": "4.12.1",
      "@base-ui/react": "1.6.0",
      "@excalidraw/excalidraw": "0.18.1",
      "@mdx-js/mdx": "3.1.1",
      "@mdx-js/react": "3.1.1",
      "@next/mdx": "16.3.1",
      "@playwright/test": "1.62.1",
      "@tailwindcss/postcss": "4.3.3",
      "@tanstack/react-query": "5.101.4",
      "@types/bun": "1.4.0",
      "@types/mdast": "4.0.4",
      "@types/mdx": "2.0.14",
      "@types/node": "26.2.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "babel-plugin-react-compiler": "1.0.0",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cmdk": "1.1.1",
      "esbuild": "0.28.2",
      "fumadocs-core": "16.15.1",
      "fumadocs-mdx": "15.3.1",
      "fumadocs-ui": "16.15.1",
      "gray-matter": "4.0.3",
      "happy-dom": "^20.11.6",
      "hast-util-to-string": "3.0.1",
      "knip": "6.33.0",
      "lucide-react": "1.30.0",
      "mdast-util-mdx-jsx": "3.2.0",
      "motion": "12.42.2",
      "next": "16.3.1",
      "next-intl": "4.14.0",
      "next-themes": "0.4.6",
      "oxfmt": "0.59.0",
      "oxlint": "1.74.0",
      "oxlint-tsgolint": "0.25.0",
      "postcss": "8.5.26",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "rehype-slug": "6.0.0",
      "remark-frontmatter": "5.0.0",
      "remark-gfm": "4.0.1",
      "remark-mdx-frontmatter": "5.2.0",
      "shadcn": "4.17.0",
      "tailwindcss": "4.3.3",
      "tailwind-merge": "3.6.0",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "unist-util-visit": "5.1.0",
      "zod": "4.4.3"
    },
    "catalogs": {
      "tooling-peer": {
        "oxfmt": ">=0.59.0 <1.0.0",
        "oxlint": ">=1.74.0 <2.0.0",
        "oxlint-tsgolint": ">=0.25.0 <1.0.0"
      },
      "ui-peer": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --audit-level high",
    "build": "bun run --workspaces --if-present build",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run deadcode && bun run test",
    "check:full": "bun run check && bun run test:e2e",
    "deadcode": "knip --include files --include duplicates --no-config-hints",
    "fmt": "oxfmt --config oxfmt.config.ts .",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "links:check": "scripts/check-links.sh",
    "postinstall": "bun run --filter @jongminchung/web postinstall",
    "test": "bun run --workspaces --if-present test && bun run test:node",
    "test:e2e": "bun run build && bun run --filter @jongminchung/web test:e2e",
    "test:node": "bun run --workspaces --if-present test:node",
    "typecheck": "tsc --noEmit && bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@jongminchung/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "fumadocs-mdx": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "fast-uri": "3.1.6",
    "lodash-es": "4.18.1",
    "nanoid": "5.1.16",
    "sharp": "0.35.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "sharp"
  ],
  "//": [
    "audit checks dependency advisories at high severity or above.",
    "It stays separate from check because the advisory database requires network access; run it manually before publishing."
  ]
}
